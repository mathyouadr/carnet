# systemd user service:  cp deploy/carnet.service ~/.config/systemd/user/
#                        systemctl --user enable --now carnet
#                        loginctl enable-linger $USER   (keep it running after logout)
# Build the web app once first: cd web && npm ci && npm run build
[Unit]
Description=Carnet - self-hosted notes
After=network-online.target

[Service]
WorkingDirectory=%h/carnet
EnvironmentFile=-%h/carnet/.env
ExecStart=/usr/bin/python3 -m carnet serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
