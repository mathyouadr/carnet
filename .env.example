# Copy this file to .env and adjust it. Every line is optional except the password.
# Keep comments on their own lines: Docker does not support "VALUE  # comment".

# --- Security --------------------------------------------------------------
# Web login. Carnet refuses to start while it is "change-me".
# Leave it empty only on a trusted network (or behind a proxy that does authentication).
CARNET_PASSWORD=change-me
# API tokens for scripts (Authorization: Bearer <token>), comma-separated.
# CARNET_TOKENS=
# Set to 1 when Carnet is served over HTTPS (Secure cookie).
# CARNET_SECURE_COOKIE=1
# Set to 1 behind a reverse proxy (real client IP for the login rate limit).
# CARNET_TRUST_PROXY=1
# Without a password, Carnet only answers to IP addresses and localhost. Add the names you open it with:
# CARNET_ALLOWED_HOSTS=notes.lan,nas.local

# --- Server ----------------------------------------------------------------
CARNET_HOST=0.0.0.0
CARNET_PORT=8044
# Serve under a sub-path behind a reverse proxy, e.g. /notes
# CARNET_BASE_PATH=
# Interface language: en or fr. Default: the browser's language.
# CARNET_LANG=fr
# Name shown in the sidebar and the browser tab.
# CARNET_TITLE=Carnet
# Force a theme (light / dark). Default: each user picks in Settings.
# CARNET_THEME=
# Largest uploaded file, in MB.
# CARNET_MAX_UPLOAD_MB=50

# --- Look ------------------------------------------------------------------
# HTML injected in <head> / before </body> (custom CSS variables, analytics...). "@" reads a file.
# CARNET_EXTRA_HEAD=@/config/head.html
# CARNET_EXTRA_BODY=

# Markdown folders shown read-only next to your pages (files stay the source of truth)
# CARNET_MD_FOLDERS=Vault=/data/vault

# Public links (read only): a second port that serves only /s/... - publish it with a tunnel / reverse proxy
# CARNET_SHARE_PORT=8045
# CARNET_SHARE_HOST=127.0.0.1
# CARNET_SHARE_URL=https://share.example.org
